# Sample .env for kamxl_daemon.py AND kamxl_rest.py -- copy to .env in
# the project folder. Both programs read .env from the folder they're
# started in (systemd: WorkingDirectory=), so this one file configures
# both. A real environment variable always wins over a value here.
# Lines starting with # are ignored; commented-out values show the
# built-in default. .env is in .gitignore -- keep it that way, it
# holds your API token.

# --- Required -----------------------------------------------------------
# Serial port the KAM-XL is on.
KAMXL_PORT=/dev/kamxl
# This station's APRS callsign, exactly as the KAM-XL's MYCALL
# (SSID included, e.g. N0CALL-10).
KAMXL_CALLSIGN=N0CALL

# --- Connection ---------------------------------------------------------
# Host serial baud rate; must match the KAM-XL's HBAUD.
#KAMXL_BAUD=19200
# Unix socket between the daemon and the web server (both read this).
#KAMXL_SOCKET=/tmp/kamxl.sock

# --- History (received messages, sent messages, reception charts) -------
# Leave unset to keep nothing on disk.
KAMXL_HISTORY_DB=/var/lib/kamxl/reception.sqlite3

# --- APRS transmit ------------------------------------------------------
# Digipeater path for messages, ACKs, resends and beacons.
# DIRECT = no digipeaters.
#KAMXL_APRS_PATH=WIDE1-1,WIDE2-1
# Automatically acknowledge messages addressed to you.
KAMXL_AUTO_ACK=1
# Automatically resend messages that haven't been acknowledged.
KAMXL_AUTO_RETRY=1
# Resends per message (1-5).
KAMXL_RETRY_COUNT=3
# Seconds before the first resend (min 30); doubles after each one.
KAMXL_RETRY_INTERVAL=60

# --- Position beacon ----------------------------------------------------
# Decimal degrees; west and south are negative.
KAMXL_LATITUDE=42.422
KAMXL_LONGITUDE=-96.642
# Up to 43 characters.
KAMXL_BEACON_COMMENT=N0CALL Kam-XL
# APRS symbol table + code (2 characters); /- is a house.
#KAMXL_BEACON_SYMBOL=/-
# Minutes between beacons (min 10).
#KAMXL_BEACON_INTERVAL=30
# Start beaconing when the daemon starts.
KAMXL_BEACON=1

# --- Reception watchdog -------------------------------------------------
# Warn after this many minutes of hearing nothing but your own
# stations; 0 turns it off (min 5).
KAMXL_WATCHDOG_MINUTES=30

# --- Winlink web-service API (gateway lists, account lookups) -----------
# Access key issued by the Winlink Development Team. Optional; only the
# Winlink gateway/account features need it.
#WINLINK_API_KEY=

# --- Web dashboard / REST API (kamxl_rest.py) ----------------------------
# Bearer token for the dashboard and API. If unset, a random one is
# generated at every start (and your bookmarked link stops working).
KAMXL_REST_API_KEY=change-me
# Address and port to listen on (0.0.0.0 = whole LAN).
#KAMXL_REST_HOST=0.0.0.0
#KAMXL_REST_PORT=8080
