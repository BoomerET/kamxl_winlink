# Sample .env for tncstation_daemon.py AND tncstation_rest.py -- copy to .env in
# the project folder. Both programs read .env from the folder they're
# started in (systemd: WorkingDirectory=), so this one file configures
# both. A real environment variable always wins over a value here.
# Lines starting with # are ignored; commented-out values show the
# built-in default. .env is in .gitignore -- keep it that way, it
# holds your API token.

# --- Required -----------------------------------------------------------
# Serial port the TNC is on (e.g. /dev/ttyUSB0 for a KAM-XL on a USB
# serial adapter, /dev/ttyACM0 for an OpenTNC), or tcp://host:port for
# KISS over TCP (Direwolf).
TNCSTATION_PORT=/dev/kamxl
# This station's APRS callsign, exactly as the TNC's MYCALL (KAM-XL or
# OpenTNC), SSID included, e.g. N0CALL-10. In KISS mode it's also the
# source address of everything this station transmits.
TNCSTATION_CALLSIGN=N0CALL

# --- Connection ---------------------------------------------------------
# Which TNC is on TNCSTATION_PORT:
#   kamxl    Kantronics KAM-XL (the default)
#   opentnc  NA6D/AE6EO OpenTNC. In Terminal Mode: receive, map, terminal
#            and connected mode, but no APRS transmit yet; in KISS mode
#            (below): receive and APRS transmit. See docs/opentnc.md.
#            Shows up as /dev/ttyACM0 (Linux), /dev/cu.usbmodem* (macOS)
#            or COMx.
#   kiss     any TNC already in KISS mode, or Direwolf
#TNCSTATION_TNC=kamxl
# terminal (default) or kiss. KISS mode is monitoring and APRS only --
# no web terminal, connected mode, PBBS or Winlink. TNCSTATION_TNC=kiss
# is a TNC already in KISS, or Direwolf: TNCSTATION_PORT=tcp://localhost:8001
# See docs/kiss.md.
#TNCSTATION_MODE=terminal
# Host serial baud rate; for a KAM-XL it must match its HBAUD. (The
# OpenTNC's USB port and tcp:// ignore it.)
#TNCSTATION_BAUD=19200
# Unix socket between the daemon and the web server (both read this).
#TNCSTATION_SOCKET=/tmp/tncstation.sock
# Extra-detailed logging (DEBUG level) for both programs: every raw
# monitor read and packet (daemon) and every proxied call (web server).
# Same as --verbose; --no-verbose on the command line overrides it.
#TNCSTATION_VERBOSE=0

# --- History (received messages, sent messages, reception charts) -------
# Leave unset to keep nothing on disk.
TNCSTATION_HISTORY_DB=/var/lib/tncstation/reception.sqlite3
# Delete packet history (the reception charts' data) older than this
# many days, checked at startup and daily. 0 keeps everything;
# otherwise at least 31. Received and sent messages are never pruned.
#TNCSTATION_HISTORY_DAYS=90

# Daily backup of the history database into this folder -- normally a
# network share mounted by Linux (see docs/backup.md for SMB setup; the
# share's password goes in the mount's credentials file, not here).
# Off when unset. Refused if the folder is on the same disk as the
# database (share not mounted?) unless TNCSTATION_BACKUP_ALLOW_SAME_DISK=1.
#TNCSTATION_BACKUP_DIR=/mnt/tncstation-backup
#TNCSTATION_BACKUP_KEEP=7
#TNCSTATION_BACKUP_TIME=03:30
#TNCSTATION_BACKUP_ALLOW_SAME_DISK=1

# --- APRS transmit ------------------------------------------------------
# Digipeater path for messages, ACKs, resends and beacons.
# DIRECT = no digipeaters.
#TNCSTATION_APRS_PATH=WIDE1-1,WIDE2-1
# AX.25 destination ("tocall") on everything sent: identifies the software
# (https://github.com/aprsorg/aprs-deviceid). APZTNC is from the range set
# aside for experimental software, until tncstation has its own. APRS is
# the old generic value.
#TNCSTATION_TOCALL=APZTNC
# Automatically acknowledge messages addressed to you.
TNCSTATION_AUTO_ACK=1
# Automatically resend messages that haven't been acknowledged.
TNCSTATION_AUTO_RETRY=1
# Resends per message (1-5).
TNCSTATION_RETRY_COUNT=3
# Seconds before the first resend (min 30); doubles after each one.
TNCSTATION_RETRY_INTERVAL=60

# --- Position beacon ----------------------------------------------------
# Decimal degrees; west and south are negative.
TNCSTATION_LATITUDE=42.422
TNCSTATION_LONGITUDE=-96.642
# Up to 43 characters.
TNCSTATION_BEACON_COMMENT=N0CALL Kam-XL
# APRS symbol table + code (2 characters); /- is a house.
#TNCSTATION_BEACON_SYMBOL=/-
# Minutes between beacons (min 10).
#TNCSTATION_BEACON_INTERVAL=30
# Start beaconing when the daemon starts.
TNCSTATION_BEACON=1

# --- Reception watchdog -------------------------------------------------
# Warn after this many minutes of hearing nothing but your own
# stations; 0 turns it off (min 5).
TNCSTATION_WATCHDOG_MINUTES=30

# --- Phone notifications (ntfy) ----------------------------------------
# Off unless both URL and topic are set. Install the ntfy app on your
# phone and subscribe to the same topic on the same server.
#TNCSTATION_NTFY_URL=https://ntfy.sh
#TNCSTATION_NTFY_TOPIC=pick-a-hard-to-guess-topic
# What to send: messages, bulletins, watchdog, backup (comma list).
#TNCSTATION_NTFY_EVENTS=messages,watchdog,backup
# ntfy access token, if your server requires one.
#TNCSTATION_NTFY_TOKEN=tk_...
# Cloudflare Access service token, if the server sits behind Access.
#TNCSTATION_NTFY_CF_ACCESS_CLIENT_ID=xxxxxxxx.access
#TNCSTATION_NTFY_CF_ACCESS_CLIENT_SECRET=...
# Link opened when you tap a notification (e.g. your dashboard).
#TNCSTATION_NTFY_CLICK_URL=http://maestro.local:8080/?token=...

# --- Winlink web-service API (gateway lists, account lookups) -----------
# Access key issued by the Winlink Development Team. Optional; only the
# Winlink gateway/account features need it.
#WINLINK_API_KEY=

# --- Web dashboard / REST API (tncstation_rest.py) ----------------------------
# Bearer token for the dashboard and API. If unset, a random one is
# generated at every start (and your bookmarked link stops working).
TNCSTATION_REST_API_KEY=change-me
# Address and port to listen on (0.0.0.0 = whole LAN).
#TNCSTATION_REST_HOST=0.0.0.0
#TNCSTATION_REST_PORT=8080
