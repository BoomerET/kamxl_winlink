# Sample environment for kamxl_rest.py (the web dashboard / REST API).
# The web server does NOT read the project's .env file; give it these
# through systemd (EnvironmentFile=/etc/kamxl/web.env) or the shell.

# Bearer token for the dashboard and API. If unset, a random one is
# generated and printed at startup.
KAMXL_REST_API_KEY=change-me
# Address and port to listen on (0.0.0.0 = whole LAN).
#KAMXL_REST_HOST=0.0.0.0
#KAMXL_REST_PORT=8080
# Must match the daemon's socket.
#KAMXL_SOCKET=/tmp/kamxl.sock
